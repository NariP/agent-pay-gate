# Copy to .env and fill in. Leave the PayPal values empty to run against the built-in mock.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_LOCALE=en-US

# AI order check (optional). Any OpenAI-compatible chat completions endpoint works.
# Leave the key empty to turn the check off.
AI_REVIEW_API_KEY=
AI_REVIEW_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
AI_REVIEW_MODEL=deepseek-v4-1-flash-261017
# Model for the demo shopping agent on the storefront. It needs tool calling.
AI_AGENT_MODEL=deepseek-v4-1-flash-261017

# Merchant policy
MAX_ORDER_USD=20
DAILY_LIMIT_USD=60
QUOTE_TTL_MIN=15

# Browser origins allowed to call the MCP endpoint, comma separated. The gate's own origin is always allowed.
MCP_ALLOWED_ORIGINS=

# Approval pages
GATE_PORT=8787
MERCHANT_NAME=Slow Morning Coffee
